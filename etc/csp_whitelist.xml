<?xml version="1.0"?>
<!--
    Magento 2.4.7+ enforces the Content Security Policy on the checkout page. Without this entry the browser refuses
    to load the embedded Idenfy verification UI.
-->
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="frame-src">
            <values>
                <value id="idenfy-ui" type="host">https://ui.idenfy.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
