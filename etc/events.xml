<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Rejects orders of unverified customers, whichever checkout, express button or API placed them -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="idenfy_prevent_unverified_order" instance="Idenfy\CustomerVerification\Observer\PreventUnverifiedOrder" />
    </event>
</config>
